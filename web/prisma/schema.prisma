generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @map("_id") 
  name          String
  email         String    @unique
  emailVerified Boolean?
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  role          Role      @default(USER)
  carrinhoJson  String?   
  compras       Compra[]  

  @@map("user")
}




// evitar mexer daqui pra baixo
// nesses 3 modelos do better auth
model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Categoria {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  nome        String    @unique
  
  productIDs  String[]  @db.ObjectId
  produtos    Produto[] @relation(fields: [productIDs], references: [id])
}

model Produto {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  descricao   String
  preco       Float
  imagem      String?
  categoryIDs String[]    @db.ObjectId
  categorias  Categoria[] @relation(fields: [categoryIDs], references: [id])
  compraIDs   String[]    @db.ObjectId
  compras     Compra[]    @relation(fields: [compraIDs], references: [id])
}

model Compra {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  precoTotal  Float       // Exigência: calculado no backend
  userId      String   
  user        User        @relation(fields: [userId], references: [id])
  produtoIDs  String[]    @db.ObjectId
  produtos    Produto[]   @relation(fields: [produtoIDs], references: [id])
  criadoEm    DateTime    @default(now())
  @@map("compras")
}